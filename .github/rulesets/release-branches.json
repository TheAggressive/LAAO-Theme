{
	"name": "release-branches",
	"target": "branch",
	"enforcement": "active",
	"conditions": {
		"ref_name": {
			"include": ["refs/heads/main", "refs/heads/master"],
			"exclude": []
		}
	},
	"bypass_actors": [],
	"rules": [
		{
			"type": "deletion"
		},
		{
			"type": "non_fast_forward"
		}
	]
}
