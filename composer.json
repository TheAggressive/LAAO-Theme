{
	"name": "theaggressive/laao",
	"description": "Official Block Theme for LAArtsOnline.com",
	"type": "wordpress-theme",
	"license": "MIT",
	"authors": [
		{
			"name": "The Aggressive, LLC",
			"homepage": "https://theaggressive.com"
		}
	],
	"require": {
		"php": ">=8.4"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.1",
		"brain/monkey": "^2.7",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.8",
		"phpcompatibility/php-compatibility": "^9.3",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^13.0",
		"squizlabs/php_codesniffer": "^3.13.5",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"autoload": {
		"classmap": [
			"inc/"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"LAAO\\Tests\\": "tests/php/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"analyse": "phpstan analyse --memory-limit=2G",
		"analyse:baseline": "phpstan analyse --generate-baseline --memory-limit=2G",
		"phpcs": "phpcs",
		"phpcs:fix": "phpcbf",
		"lint:php": "@phpcs",
		"lint:php:fix": "@phpcs:fix"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.4.1"
		},
		"sort-packages": true
	}
}
