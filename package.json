{
	"name": "laao",
	"version": "1.14.2",
	"description": "Official Block Theme for LAArtsOnline.com",
	"author": "The Aggressive, LLC",
	"license": "MIT",
	"main": "index.js",
	"keywords": [
		"Wordpress",
		"Theme",
		"Blocks",
		"LAArtsOnline.com"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TheAggressive/LAAO-Theme.git"
	},
	"bugs": {
		"url": "https://github.com/TheAggressive/LAAO-Theme/issues"
	},
	"homepage": "https://github.com/TheAggressive/LAAO-Theme#readme",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=11 <12"
	},
	"packageManager": "pnpm@11.1.2",
	"scripts": {
		"prepare": "husky",
		"create-block": "npx @wordpress/create-block@latest --no-plugin --namespace laao",
		"create-block-dynamic": "npx @wordpress/create-block@latest --no-plugin --namespace laao --variant dynamic",
		"create-block-interactive": "npx @wordpress/create-block@latest --no-plugin --namespace laao --template @wordpress/create-block-interactive-template",
		"build": "concurrently 'pnpm build:blocks' 'pnpm build:interactivity' 'pnpm build:assets'",
		"build:blocks": "wp-scripts build --webpack-src-dir=./src/blocks --output-path=./dist/blocks",
		"build:interactivity": "wp-scripts build --webpack-src-dir=./src/blocks-interactivity --output-path=./dist/blocks-interactivity --experimental-modules",
		"build:assets": "wp-scripts build --config webpack.assets.config.mjs",
		"start": "concurrently 'pnpm start:blocks' 'pnpm start:interactivity' 'pnpm start:assets'",
		"start:blocks": "wp-scripts start --webpack-src-dir=./src/blocks --output-path=./dist/blocks",
		"start:interactivity": "wp-scripts start --webpack-src-dir=./src/blocks-interactivity --output-path=./dist/blocks-interactivity --experimental-modules",
		"start:assets": "wp-scripts start --config webpack.assets.config.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "pnpm lint:js && pnpm lint:css && pnpm lint:php && pnpm lint:files",
		"lint:js": "eslint 'src/**/*.{js,jsx,ts,tsx}' 'bin/**/*.mjs' --max-warnings 0",
		"lint:js:fix": "eslint 'src/**/*.{js,jsx,ts,tsx}' 'bin/**/*.mjs' --fix",
		"lint:css": "wp-scripts lint-style 'src/**/*.css'",
		"lint:css:fix": "wp-scripts lint-style 'src/**/*.css' --fix",
		"lint:php": "composer run-script phpcs",
		"lint:php:fix": "composer run-script phpcs:fix",
		"lint:files": "bash bin/check-file-length.sh && bash bin/ci/check-action-pins.sh && bash bin/ci/check-template-colors.sh && node bin/ci/check-z-index.mjs",
		"test:tools": "bash bin/ci/dependabot-major-guard.test.sh",
		"lint:commit": "commitlint --edit",
		"typecheck": "tsc --noEmit",
		"analyse:php": "composer run-script analyse",
		"test": "concurrently 'pnpm test:php' 'pnpm test:js'",
		"test:js": "wp-scripts test-unit-js",
		"test:js:watch": "wp-scripts test-unit-js --watch",
		"test:php": "vendor/bin/phpunit",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:install": "playwright install chromium",
		"palette:baseline": "node bin/ci/palette-baseline.mjs",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean all",
		"env:destroy": "wp-env destroy",
		"env:logs": "wp-env logs",
		"cli": "wp-env run cli wp",
		"release:package": "bash bin/release/package.sh",
		"release:verify": "bash bin/release/verify-package.sh",
		"ci:doctor": "node bin/ci/doctor.mjs",
		"ci:frontend": "pnpm lint:js && pnpm lint:css && pnpm format:check && pnpm typecheck && pnpm lint:files && pnpm test:tools && pnpm test:js",
		"ci:i18n": "pnpm ci:doctor && bash bin/ci/i18n.sh",
		"ci:php": "pnpm lint:php && pnpm analyse:php && pnpm test:php",
		"ci:build": "pnpm build && node bin/ci/check-asset-budget.mjs",
		"ci:e2e": "pnpm test:e2e",
		"ci:package": "pnpm release:package && pnpm release:verify",
		"ci:verify": "bash bin/ci/verify.sh",
		"qa": "pnpm ci:frontend && pnpm ci:php",
		"packages-update": "wp-scripts packages-update",
		"i18n": "bash bin/i18n/all.sh",
		"i18n:pot": "bash bin/i18n/pot.sh",
		"i18n:sync": "bash bin/i18n/sync.sh",
		"i18n:compile": "bash bin/i18n/compile.sh",
		"i18n:status": "bash bin/i18n/status.sh",
		"i18n:check": "bash bin/i18n/check.sh",
		"i18n:locale": "bash bin/i18n/locale-new.sh",
		"perf": "pnpm build && node bin/perf.mjs budget",
		"perf:report": "pnpm build && node bin/perf.mjs report"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"dependencies": {
		"@wordpress/scripts": "^34.0.0",
		"gsap": "^3.15.0",
		"isomorphic-dompurify": "^2.24.0",
		"lenis": "^1.3.25"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@commitlint/cli": "^20.4.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.9",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.25",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/wordpress__block-editor": "^15.0.6",
		"@types/wordpress__block-library": "^2.6.3",
		"@types/wordpress__blocks": "^15.10.0",
		"@types/wordpress__edit-post": "^8.4.2",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"@wordpress/a11y": "^4.52.0",
		"@wordpress/api-fetch": "^7.52.0",
		"@wordpress/autop": "^4.52.0",
		"@wordpress/block-editor": "^14.18.0",
		"@wordpress/blocks": "^14.12.0",
		"@wordpress/browserslist-config": "^6.52.0",
		"@wordpress/components": "^29.9.0",
		"@wordpress/core-commands": "^1.52.0",
		"@wordpress/core-data": "^7.52.0",
		"@wordpress/data": "^10.52.0",
		"@wordpress/data-controls": "^4.52.0",
		"@wordpress/dataviews": "^17.3.0",
		"@wordpress/date": "^5.52.0",
		"@wordpress/deprecated": "^4.52.0",
		"@wordpress/dom": "^4.52.0",
		"@wordpress/dom-ready": "^4.52.0",
		"@wordpress/edit-post": "^8.52.0",
		"@wordpress/editor": "^14.52.0",
		"@wordpress/element": "^6.23.0",
		"@wordpress/env": "^11.12.0",
		"@wordpress/eslint-plugin": "^25.8.0",
		"@wordpress/hooks": "^4.52.0",
		"@wordpress/html-entities": "^4.52.0",
		"@wordpress/i18n": "^5.23.0",
		"@wordpress/icons": "^10.23.0",
		"@wordpress/interactivity": "^6.52.0",
		"@wordpress/patterns": "^2.52.0",
		"@wordpress/plugins": "^7.52.0",
		"@wordpress/preferences": "^4.52.0",
		"@wordpress/prettier-config": "^4.52.0",
		"@wordpress/primitives": "^4.52.0",
		"@wordpress/server-side-render": "^5.23.0",
		"@wordpress/stylelint-config": "^23.15.0",
		"autoprefixer": "^10.5.4",
		"browser-sync-webpack-plugin": "^2.4.0",
		"browserslist": "^4.28.7",
		"concurrently": "^9.1.2",
		"copy-webpack-plugin": "^12.0.2",
		"cssnano": "^7.0.7",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"fast-glob": "^3.3.3",
		"globals": "^17.9.0",
		"husky": "^9.1.7",
		"lodash": "^4.18.1",
		"postcss": "^8.5.26",
		"postcss-cli": "^11.0.1",
		"postcss-custom-properties": "^14.0.4",
		"postcss-for": "^2.1.1",
		"postcss-import": "^16.1.1",
		"postcss-mixins": "^11.0.3",
		"postcss-nesting": "^14.0.1",
		"postcss-preset-env": "^10.1.6",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.9.6",
		"semantic-release": "^25.0.9",
		"stylelint": "^16.19.1",
		"stylelint-config-standard": "^38.0.0",
		"stylelint-config-standard-scss": "^14.0.0",
		"typescript": "^5.8.3",
		"webpack-fix-style-only-entries": "^0.6.1",
		"webpack-remove-empty-scripts": "^1.1.1"
	}
}
